rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }
    // ¿Es la cuenta de nodo vinculada a este dispositivo? Se vincula de forma
    // opcional (claim por admin o futura versión del firmware) con el email de
    // la cuenta del nodo (`nodo@medidor.cl`). Con el vínculo, el nodo puede
    // actualizar telemetría de ese dispositivo aunque no sea su dueño. Sin el
    // vínculo, la telemetría la escribe igualmente el dueño/admin/manager.
    function isNodeAccount(deviceData) {
      return request.auth.token.email != null &&
        deviceData.nodeAccountEmail != null &&
        request.auth.token.email == deviceData.nodeAccountEmail;
    }
    // Un usuario no puede crear/vincular un dispositivo a nombre de la cuenta
    // del nodo: ese campo solo se puede escribir en `create`. Los updates
    // (migración/existencia) los aplica el admin manualmente o el claim al
    // volver a registrar el dispositivo.
    function canBindNode(deviceData) {
      return isAdmin() ||
        (deviceData.nodeAccountEmail == null &&
         request.resource.data.nodeAccountEmail == null);
    }
    // ¿Este usuario es el dueño/manager del device (o del campo al que
    // pertenece)? Para compartidos: dueño del device, rol 'manager' por email,
    // admin, o manager del campo vía `fieldId`.
    function isManagerOfDevice(deviceData) {
      return deviceData.owner == request.auth.uid
        || isAdmin()
        || shareRole(deviceData) == 'manager'
        || (deviceData.fieldId != null && fieldManagerById(deviceData.fieldId));
    }
    // Rol del usuario sobre un campo a través de `sharedWith`/shares del campo.
    function fieldManagerById(fieldId) {
      let f = get(/databases/$(database)/documents/fields/$(fieldId)).data;
      return f.shares != null && f.shares[request.auth.token.email] == 'manager';
    }
    // Rol del usuario actual sobre un dispositivo (null si no tiene acceso
    // compartido). Los accesos se comparten por email: {email: 'viewer'|'manager'}.
    function shareRole(deviceData) {
      return deviceData.shares != null && deviceData.shares[request.auth.token.email] != null
        ? deviceData.shares[request.auth.token.email]
        : null;
    }
    // ¿El email del usuario está en el array `sharedWith`? Este array existe
    // para que las queries de lista del invitado sean validables por las reglas
    // (Firestore niega listas con filtros `!= null` sobre mapas).
    function isSharedWith(deviceData) {
      return deviceData.sharedWith != null &&
        request.auth.token.email in deviceData.sharedWith;
    }
    // ¿Un campo está compartido con el email del usuario actual (invitado)?
    function fieldSharedWith(fieldData) {
      return fieldData != null && fieldData.sharedWith != null &&
        request.auth.token.email in fieldData.sharedWith;
    }
    function canReadField(fieldData) {
      return fieldData != null && (
        fieldData.owner == request.auth.uid || isAdmin() || fieldSharedWith(fieldData)
      );
    }
    function canReadFieldById(fieldId) {
      return canReadField(get(/databases/$(database)/documents/fields/$(fieldId)).data);
    }
    // Lee un dispositivo si es dueño, admin, compartido por email, o pertenece a
    // un campo compartido con el email del usuario (invitado aprobado).
    function canReadDeviceData(deviceData) {
      return deviceData.owner == request.auth.uid
        || isAdmin()
        || isSharedWith(deviceData)
        || shareRole(deviceData) != null
        || (deviceData.fieldId != null && fieldSharedWith(
          get(/databases/$(database)/documents/fields/$(deviceData.fieldId)).data));
    }
    function canReadDevice(deviceId) {
      return canReadDeviceData(get(/databases/$(database)/documents/devices/$(deviceId)).data);
    }
    function canManageDevice(deviceId) {
      let d = get(/databases/$(database)/documents/devices/$(deviceId)).data;
      return d.owner == request.auth.uid || isAdmin() || shareRole(d) == 'manager';
    }
    // Invitaciones: el dueño del campo (o admin) gestiona; cualquiera autenticado
    // puede LEER un token para validarlo al registrarse.
    function canManageInvite(ownerUid) {
      return ownerUid == request.auth.uid || isAdmin();
    }

    match /users/{userId} {
      // Un usuario puede leer su perfil (o cualquier admin); solo él mismo crea
      // su cuenta (con rol 'user') y se actualiza sin poder auto-promoverse.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.rol == 'user';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.rol != 'admin') || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /devices/{deviceId} {
      // Claim: cualquier usuario autenticado crea SU dispositivo (owner = uid) y
      // el claim NO puede fijar la cuenta del nodo (solo admin, para evitar que
      // un atacante vincule un dispositivo a la cuenta del nodo). El nodo
      // (cuenta vinculada por `nodeAccountEmail`) puede actualizar telemetría.
      // Dueño/admin/manager gestionan (config, válvula y lecturas).
      allow read: if isSignedIn() && canReadDeviceData(resource.data);
      allow create: if isSignedIn() &&
        request.resource.data.owner == request.auth.uid &&
        canBindNode(request.resource.data);
      allow update: if isSignedIn() && (
        resource.data.owner == request.auth.uid ||
        isAdmin() ||
        isManagerOfDevice(resource.data) ||
        (isNodeAccount(resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'humidity', 'soilTemp', 'batteryLevel', 'rssi', 'intervalMin',
           'autonomyDays', 'lastReportAt', 'depthCm'
         ]))
      );
      allow delete: if isAdmin();

      match /readings/{readingId} {
        allow read: if isSignedIn() && canReadDevice(deviceId);
        // La telemetría la alta el nodo (cuenta vinculada por nodeAccountEmail)
        // y cualquier nodo legítimo de la fase actual (firmware sin vínculo).
        // El borrado/edición masiva (datos demo) queda solo para dueño/admin/manager.
        allow create: if isSignedIn() &&
          (isManagerOfDevice(get(/databases/$(database)/documents/devices/$(deviceId)).data) ||
           isNodeAccount(get(/databases/$(database)/documents/devices/$(deviceId)).data));
        allow update, delete: if isSignedIn() &&
          isManagerOfDevice(get(/databases/$(database)/documents/devices/$(deviceId)).data);
      }

      match /config/{configId} {
        // Aquí vive el comando de válvula (`valveState`). SOLO el dueño, admin o
        // manager puede ESCRIBIR. La lectura queda abierta a usuarios autenticados
        // para no romper el firmware desplegado (que aún no vincula nodeAccountEmail).
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() &&
          isManagerOfDevice(get(/databases/$(database)/documents/devices/$(deviceId)).data);
      }
    }

    match /fields/{fieldId} {
      // Campos/parcelas: nombre + coordenadas para clima y agrupación de sondas.
      // Lee el dueño, admin o quien esté en `sharedWith` (invitado aprobado).
      allow read: if isSignedIn() && canReadField(resource.data);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (resource.data.owner == request.auth.uid || isAdmin());

      match /sectors/{sectorId} {
        // Sectores de riego del campo (diseño: variedad, área, emisores).
        allow read: if isSignedIn() && canReadFieldById(fieldId);
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() &&
          (get(/databases/$(database)/documents/fields/$(fieldId)).data.owner == request.auth.uid || isAdmin());
      }
    }

    match /crops/{cropId} {
      // Perfiles de cultivo: cualquier autenticado puede crear; solo su dueño o admin escribe.
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (resource.data.owner == request.auth.uid || isAdmin());
    }

    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Invitaciones para compartir la app: {ownerUid, fieldId, createdAt, email?}.
    // El token (id del documento) viaja en el QR/enlace.
    match /invites/{token} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        canManageInvite(resource.data.ownerUid);
    }

    // Solicitudes de acceso de los invitados. El dueño del campo (o admin) ve y
    // aprueba/rechaza; el solicitante solo crea su propia solicitud 'pending' y
    // puede leer su propio estado para saber si fue aprobado o revocado.
    match /access_requests/{requestId} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /commands/{commandId} {
      allow read: if isSignedIn() && canReadDevice(resource.data.deviceId);
      // Crear un comando (p. ej. abrir válvula) es operación de gestión: solo
      // dueño/admin/manager del dispositivo, no cualquier usuario autenticado.
      allow create: if isSignedIn() && canManageDevice(resource.data.deviceId);
      allow update: if isSignedIn() && (
        resource.data.owner == request.auth.uid || isAdmin() ||
        canManageDevice(resource.data.deviceId));
      allow delete: if isAdmin();
    }

    match /irrigationEvents/{eventId} {
      allow read: if isSignedIn() && canReadDevice(resource.data.deviceId);
      allow create: if isSignedIn() && canManageDevice(resource.data.deviceId);
      allow update: if isSignedIn() && (
        resource.data.owner == request.auth.uid || isAdmin() ||
        canManageDevice(resource.data.deviceId));
      allow delete: if isAdmin();
    }

    match /sectorClimate/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
