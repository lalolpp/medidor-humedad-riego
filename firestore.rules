rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }
    // Rol del usuario actual sobre un dispositivo (null si no tiene acceso
    // compartido). Los accesos se comparten por email: {email: 'viewer'|'manager'}.
    function shareRole(deviceData) {
      return deviceData.shares != null && deviceData.shares[request.auth.token.email] != null
        ? deviceData.shares[request.auth.token.email]
        : null;
    }
    // ¿El email del usuario está en el array `sharedWith`? Este array existe
    // para que las queries de lista del invitado sean validables por las reglas
    // (Firestore niega listas con filtros `!= null` sobre mapas).
    function isSharedWith(deviceData) {
      return deviceData.sharedWith != null &&
        request.auth.token.email in deviceData.sharedWith;
    }
    // ¿Un campo está compartido con el email del usuario actual (invitado)?
    function fieldSharedWith(fieldData) {
      return fieldData != null && fieldData.sharedWith != null &&
        request.auth.token.email in fieldData.sharedWith;
    }
    function canReadField(fieldData) {
      return fieldData != null && (
        fieldData.owner == request.auth.uid || isAdmin() || fieldSharedWith(fieldData)
      );
    }
    function canReadFieldById(fieldId) {
      return canReadField(get(/databases/$(database)/documents/fields/$(fieldId)).data);
    }
    // Lee un dispositivo si es dueño, admin, compartido por email, o pertenece a
    // un campo compartido con el email del usuario (invitado aprobado).
    function canReadDeviceData(deviceData) {
      return deviceData.owner == request.auth.uid
        || isAdmin()
        || isSharedWith(deviceData)
        || shareRole(deviceData) != null
        || (deviceData.fieldId != null && fieldSharedWith(
          get(/databases/$(database)/documents/fields/$(deviceData.fieldId)).data));
    }
    function canReadDevice(deviceId) {
      return canReadDeviceData(get(/databases/$(database)/documents/devices/$(deviceId)).data);
    }
    function canManageDevice(deviceId) {
      let d = get(/databases/$(database)/documents/devices/$(deviceId)).data;
      return d.owner == request.auth.uid || isAdmin() || shareRole(d) == 'manager';
    }
    // Invitaciones: el dueño del campo (o admin) gestiona; cualquiera autenticado
    // puede LEER un token para validarlo al registrarse.
    function canManageInvite(ownerUid) {
      return ownerUid == request.auth.uid || isAdmin();
    }

    match /users/{userId} {
      // Un usuario puede leer su perfil (o cualquier admin); solo él mismo crea
      // su cuenta (con rol 'user') y se actualiza sin poder auto-promoverse.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.rol == 'user';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.rol != 'admin') || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /devices/{deviceId} {
      // Claim: cualquier usuario autenticado puede crear un dispositivo sin dueño;
      // dueño, admin o compartido (viewer/manager) lee; manager escribe.
      // El nodo (cualquier usuario autenticado) puede actualizar SOLO telemetría.
      allow read: if isSignedIn() && canReadDeviceData(resource.data);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.owner == request.auth.uid || isAdmin() ||
        shareRole(resource.data) == 'manager' ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'humidity', 'soilTemp', 'batteryLevel', 'rssi', 'intervalMin',
          'autonomyDays', 'lastReportAt', 'depthCm'
        ])
      );
      allow delete: if isAdmin();

      match /readings/{readingId} {
        allow read: if isSignedIn() && canReadDevice(deviceId);
        allow create: if isSignedIn();
        // El dueño/admin/manager puede corregir o limpiar las lecturas de su
        // propio dispositivo (p. ej. regenerar datos de demostración).
        allow update, delete: if isSignedIn() && canManageDevice(deviceId);
      }

      match /config/{configId} {
        // Configuración remota del nodo (p. ej. intervalo de reporte/deep
        // sleep). El nodo autenticado la lee; dueño, admin o manager la escribe.
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && canManageDevice(deviceId);
      }
    }

    match /fields/{fieldId} {
      // Campos/parcelas: nombre + coordenadas para clima y agrupación de sondas.
      // Lee el dueño, admin o quien esté en `sharedWith` (invitado aprobado).
      allow read: if isSignedIn() && canReadField(resource.data);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (resource.data.owner == request.auth.uid || isAdmin());

      match /sectors/{sectorId} {
        // Sectores de riego del campo (diseño: variedad, área, emisores).
        allow read: if isSignedIn() && canReadFieldById(fieldId);
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() &&
          (get(/databases/$(database)/documents/fields/$(fieldId)).data.owner == request.auth.uid || isAdmin());
      }
    }

    match /crops/{cropId} {
      // Perfiles de cultivo: cualquier autenticado puede crear; solo su dueño o admin escribe.
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (resource.data.owner == request.auth.uid || isAdmin());
    }

    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Invitaciones para compartir la app: {ownerUid, fieldId, createdAt, email?}.
    // El token (id del documento) viaja en el QR/enlace.
    match /invites/{token} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        canManageInvite(resource.data.ownerUid);
    }

    // Solicitudes de acceso de los invitados. El dueño del campo (o admin) ve y
    // aprueba/rechaza; el solicitante solo crea su propia solicitud 'pending' y
    // puede leer su propio estado para saber si fue aprobado o revocado.
    match /access_requests/{requestId} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /commands/{commandId} {
      allow read: if isSignedIn() && canReadDevice(resource.data.deviceId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.owner == request.auth.uid || isAdmin() ||
        canManageDevice(resource.data.deviceId));
      allow delete: if isAdmin();
    }

    match /irrigationEvents/{eventId} {
      allow read: if isSignedIn() && canReadDevice(resource.data.deviceId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.owner == request.auth.uid || isAdmin() ||
        canManageDevice(resource.data.deviceId));
      allow delete: if isAdmin();
    }

    match /sectorClimate/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
