rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }

    match /users/{userId} {
      // Un usuario puede leer su perfil (o cualquier admin); solo él mismo crea
      // su cuenta (con rol 'user') y se actualiza sin poder auto-promoverse.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.rol == 'user';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.rol != 'admin') || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /devices/{deviceId} {
      // Claim: cualquier usuario autenticado puede crear un dispositivo sin dueño;
      // solo dueño o admin lee/actualiza; solo admin borra.
      // El nodo (cualquier usuario autenticado) puede actualizar SOLO telemetría.
      allow read: if isSignedIn() && (resource.data.owner == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.owner == request.auth.uid || isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'humidity', 'soilTemp', 'batteryLevel', 'intervalMin',
          'autonomyDays', 'lastReportAt'
        ])
      );
      allow delete: if isAdmin();

      match /readings/{readingId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/devices/$(deviceId)).data.owner == request.auth.uid || isAdmin());
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }

      match /config/{configId} {
        // Configuración remota del nodo (p. ej. intervalo de reporte/deep
        // sleep). El nodo autenticado la lee; solo dueño o admin la escribe.
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() &&
          (get(/databases/$(database)/documents/devices/$(deviceId)).data.owner == request.auth.uid || isAdmin());
      }
    }

    match /fields/{fieldId} {
      // Campos/parcelas: nombre + coordenadas para clima y agrupación de sondas.
      allow read: if isSignedIn() && (resource.data.owner == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (resource.data.owner == request.auth.uid || isAdmin());

      match /sectors/{sectorId} {
        // Sectores de riego del campo (diseño: variedad, área, emisores).
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/fields/$(fieldId)).data.owner == request.auth.uid || isAdmin());
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() &&
          (get(/databases/$(database)/documents/fields/$(fieldId)).data.owner == request.auth.uid || isAdmin());
      }
    }

    match /crops/{cropId} {
      // Perfiles de cultivo: cualquier autenticado puede crear; solo su dueño o admin escribe.
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (resource.data.owner == request.auth.uid || isAdmin());
    }

    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
